{
  "name": "serverless-requests",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "serverless offline",
    "typecheck": "tsc --noEmit",
    "package": "serverless package",
    "deploy": "serverless deploy",
    "migration:run": "NODE_OPTIONS='--require dotenv/config' tsx node_modules/typeorm/cli.js migration:run -d src/config/database.ts",
    "migration:revert": "NODE_OPTIONS='--require dotenv/config' tsx node_modules/typeorm/cli.js migration:revert -d src/config/database.ts",
    "migration:create": "tsx node_modules/typeorm/cli.js migration:create src/migrations/migration"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.34.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "serverless-http": "^4.0.0",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "serverless": "^4.40.0",
    "serverless-offline": "^14.7.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
